---
import type { GetStaticPaths } from "astro";
import { getCollection } from "astro:content";
import dayjs from "dayjs";
import utc from "dayjs/plugin/utc";
import timezone from "dayjs/plugin/timezone";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Pagination from "@/components/Pagination.astro";
import getSortedPosts from "@/utils/getSortedPosts";
import { getPath } from "@/utils/getPath";
import { slugifyStr } from "@/utils/slugify";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import { SITE } from "@/config";

dayjs.extend(utc);
dayjs.extend(timezone);

export const getStaticPaths = (async ({ paginate }) => {
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  return paginate(getSortedPosts(posts), { pageSize: SITE.postPerPage });
}) satisfies GetStaticPaths;

const { page } = Astro.props;

const formatDate = (date: string | Date) =>
  dayjs(date).tz(SITE.timezone).format("YYYY-MM-DD");

const estimateReadTime = (body?: string) => {
  if (!body) return 1;
  const chars = body.replace(/\s/g, "").length;
  return Math.max(1, Math.round(chars / 400));
};
---

<Layout title={`Posts | ${SITE.title}`}>
  <Header />

  <main
    id="main-content"
    data-backUrl={Astro.url.pathname}
    class="mx-auto w-full max-w-app px-4 pb-4"
  >
    <!-- ===== Page header ===== -->
    <div class="page-enter mt-8 border-b-2 border-foreground pb-3">
      <h1 class="text-2xl font-bold tracking-tight sm:text-3xl">
        全部文章
        <span
          class="ms-2 align-middle text-xs font-normal tracking-[0.25em] text-foreground/45"
        >
          ALL POSTS
        </span>
      </h1>
      <p
        class="mt-2 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-foreground/55"
      >
        <span class="font-mono tabular-nums">{page.total} 篇文章</span>
        <span aria-hidden="true">/</span>
        <span>第 {page.currentPage} / {page.lastPage} 页</span>
        <span aria-hidden="true">/</span>
        <span class="flex items-center gap-1">
          <span class="relative flex size-1.5">
            <span
              class="absolute inline-flex h-full w-full animate-ping rounded-full bg-accent opacity-60"
            ></span>
            <span class="relative inline-flex size-1.5 rounded-full bg-accent"
            ></span>
          </span>
          持续更新
        </span>
      </p>
    </div>

    <!-- ===== Post list ===== -->
    <ul class="mt-2">
      {
        page.data.map((post, index) => {
          const { id, filePath, data, body } = post;
          const { title, description, pubDatetime, modDatetime, tags } = data;
          return (
            <li
              class="reveal"
              style={`transition-delay: ${Math.min(index, 8) * 60}ms`}
            >
              <a
                href={getPath(id, filePath)}
                class="tilt-card group relative flex flex-col gap-1 border-b border-border py-4 transition-all duration-300 hover:bg-muted/30 sm:flex-row sm:gap-6 sm:px-2"
              >
                {/* Left accent bar */}
                <span
                  class="absolute inset-y-0 left-0 w-[3px] origin-center scale-y-0 bg-accent transition-transform duration-200 group-hover:scale-y-100"
                  aria-hidden="true"
                />

                {/* Date column */}
                <time
                  datetime={dayjs(modDatetime ?? pubDatetime).toISOString()}
                  class="shrink-0 font-mono text-sm text-foreground/55 tabular-nums sm:w-28 sm:pt-0.5"
                >
                  {formatDate(modDatetime ?? pubDatetime)}
                </time>

                {/* Content */}
                <span class="flex-1">
                  <h2
                    style={{ viewTransitionName: slugifyStr(title) }}
                    class="text-base leading-snug font-medium transition-colors group-hover:text-accent sm:text-lg"
                  >
                    {title}
                  </h2>
                  {description && (
                    <p class="mt-1 line-clamp-2 text-sm leading-6 text-foreground/70">
                      {description}
                    </p>
                  )}
                  <span class="mt-1.5 flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-foreground/45">
                    {tags.slice(0, 4).map(tag => (
                      <span>#{tag}</span>
                    ))}
                    <span class="text-foreground/30">
                      {estimateReadTime(body)} min
                    </span>
                  </span>
                </span>

                {/* Arrow */}
                <IconArrowRight
                  class="hidden size-4 -translate-x-1 self-center text-accent opacity-0 transition-all duration-200 group-hover:translate-x-0 group-hover:opacity-100 sm:block rtl:-rotate-180"
                  aria-hidden="true"
                />
              </a>
            </li>
          );
        })
      }
    </ul>

    <Pagination {page} />
  </main>

  <Footer noMarginTop={page.lastPage > 1} />
</Layout>

<style>
  @keyframes page-rise {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  .page-enter {
    animation: page-rise 0.4s ease-out both;
  }

  .reveal {
    opacity: 0;
    transform: translateY(16px);
    transition:
      opacity 0.5s ease-out,
      transform 0.5s ease-out;
  }
  .reveal.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .tilt-card {
    transform-style: preserve-3d;
    perspective: 600px;
  }

  @media (prefers-reduced-motion: reduce) {
    .page-enter,
    .reveal {
      animation: none !important;
      opacity: 1 !important;
      transform: none !important;
      transition: none !important;
    }
  }
</style>

<script>
  document.addEventListener("astro:page-load", () => {
    const mainContent = document.querySelector("#main-content") as HTMLElement;
    const backUrl = mainContent?.dataset?.backurl;
    if (backUrl) sessionStorage.setItem("backUrl", backUrl);

    const prefersReducedMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)"
    ).matches;

    /* ===== Scroll reveal ===== */
    const revealEls = document.querySelectorAll(".reveal");
    const observer = new IntersectionObserver(
      entries => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.1, rootMargin: "0px 0px -40px 0px" }
    );
    revealEls.forEach(el => observer.observe(el));

    /* ===== 3D tilt on cards ===== */
    if (!prefersReducedMotion) {
      document.querySelectorAll<HTMLElement>(".tilt-card").forEach(card => {
        card.addEventListener("mousemove", (e: MouseEvent) => {
          const rect = card.getBoundingClientRect();
          const cx = e.clientX - rect.left;
          const cy = e.clientY - rect.top;
          const rx = (cy / rect.height - 0.5) * -4;
          const ry = (cx / rect.width - 0.5) * 4;
          card.style.transform = `perspective(600px) rotateX(${rx}deg) rotateY(${ry}deg)`;
        });
        card.addEventListener("mouseleave", () => {
          card.style.transform = "";
        });
      });
    }
  });
</script>
