---
import { getCollection } from "astro:content";
import dayjs from "dayjs";
import utc from "dayjs/plugin/utc";
import timezone from "dayjs/plugin/timezone";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import getSortedPosts from "@/utils/getSortedPosts";
import { getPath } from "@/utils/getPath";
import { slugifyStr } from "@/utils/slugify";
import IconRss from "@/assets/icons/IconRss.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import { SITE } from "@/config";

dayjs.extend(utc);
dayjs.extend(timezone);

const posts = await getCollection("blog");

const sortedPosts = getSortedPosts(posts);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);

const formatDate = (date: string | Date) =>
  dayjs(date).tz(SITE.timezone).format("YYYY-MM-DD");

const totalPosts = sortedPosts.length;

const tagCountMap = new Map<string, number>();
sortedPosts.forEach(post =>
  post.data.tags.forEach(tag =>
    tagCountMap.set(tag, (tagCountMap.get(tag) ?? 0) + 1)
  )
);

const topTags = [...tagCountMap.entries()]
  .map(([name, count]) => ({ name, count, slug: slugifyStr(name) }))
  .sort((a, b) => b.count - a.count || a.name.localeCompare(b.name))
  .slice(0, 12);

const [latestPost, ...otherPosts] = recentPosts;

const TECH_STACK = [
  "Java",
  "Spring Boot",
  "RocketMQ",
  "Docker",
  "Git",
  "Linux",
  "Python",
];

const estimateReadTime = (body?: string) => {
  if (!body) return 1;
  const chars = body.replace(/\s/g, "").length;
  return Math.max(1, Math.round(chars / 400));
};

const tagSizeClass = (count: number) => {
  if (count >= 5) return "text-base font-semibold";
  if (count >= 3) return "text-sm font-medium";
  return "text-xs";
};
---

<Layout>
  <!-- Scroll progress bar with shimmer -->
  <div
    id="scroll-progress"
    class="fixed top-0 left-0 z-[60] h-[3px] w-full origin-left scale-x-0 bg-accent transition-transform duration-75"
  >
    <div class="shimmer absolute inset-0"></div>
  </div>

  <!-- Loading overlay -->
  <div
    id="loader"
    class="fixed inset-0 z-[100] flex items-center justify-center bg-background"
  >
    <div class="loader-text font-mono text-sm text-accent">
      <span class="loader-dots">loading</span>
    </div>
  </div>

  <Header />
  <main id="main-content" data-layout="index">
    <!-- ========== Hero ========== -->
    <section
      id="hero"
      class="hero-enter relative overflow-hidden pt-10 pb-10 sm:pt-14 sm:pb-12"
    >
      <!-- Particle canvas -->
      <canvas id="particles" class="pointer-events-none absolute inset-0 -z-10"
      ></canvas>

      <!-- Dot grid background -->
      <div
        class="pointer-events-none absolute inset-0 -z-10 opacity-30 dark:opacity-40"
        style="background-image: radial-gradient(circle, var(--color-accent) 0.5px, transparent 0.5px); background-size: 24px 24px; mask-image: linear-gradient(to bottom, transparent 0%, black 30%, black 70%, transparent 100%);"
      >
      </div>

      <!-- Radial glow -->
      <div
        class="pointer-events-none absolute -top-20 -right-20 -z-10 h-64 w-64 rounded-full opacity-15 blur-3xl dark:opacity-25"
        style="background: var(--color-accent);"
      >
      </div>

      <!-- Mouse spotlight -->
      <div
        id="spotlight"
        class="pointer-events-none absolute inset-0 -z-10 opacity-0 transition-opacity duration-300"
      >
      </div>

      <p class="flex items-center gap-2 text-sm text-foreground/55">
        <span class="inline-block size-1.5 animate-pulse rounded-full bg-accent"
        ></span>
        <span id="terminal-line"></span>
        <span
          class="cursor-blink inline-block h-4 w-[7px] translate-y-[1px] bg-accent"
        ></span>
      </p>

      <h1
        class="mt-5 text-4xl leading-tight font-bold tracking-tight sm:text-5xl"
      >
        你好，我是<span class="gradient-text whitespace-nowrap" id="hero-name"
          >大波浪</span
        >
      </h1>

      <p class="mt-5 max-w-2xl leading-8 text-foreground/80">
        <span id="typewriter"></span><span
          class="cursor-blink inline-block h-5 w-[7px] translate-y-[2px] bg-accent"
        ></span>
      </p>

      <p
        class="mt-4 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-foreground/55"
      >
        <span data-count={totalPosts} class="counter font-mono tabular-nums"
          >0</span
        >
        篇文章
        <span aria-hidden="true">/</span>
        <span
          data-count={tagCountMap.size}
          class="counter font-mono tabular-nums">0</span
        >
        个标签
        <span aria-hidden="true">/</span>
        <span class="flex items-center gap-1">
          <span class="relative flex size-1.5">
            <span
              class="absolute inline-flex h-full w-full animate-ping rounded-full bg-accent opacity-60"
            ></span>
            <span class="relative inline-flex size-1.5 rounded-full bg-accent"
            ></span>
          </span>
          持续更新中
        </span>
      </p>

      <div class="mt-5 flex flex-wrap gap-1.5">
        {
          TECH_STACK.map((tech, i) => (
            <span
              class="chip-enter float-anim border border-border/60 px-2 py-0.5 text-xs text-foreground/50 transition-all duration-200 hover:border-accent/60 hover:text-accent hover:shadow-[0_0_12px_-2px_var(--color-accent)]"
              style={`animation-delay: ${i * 80 + 200}ms; --float-delay: ${i * 0.3}s`}
            >
              {tech}
            </span>
          ))
        }
      </div>

      <div
        class="mt-8 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between"
      >
        <div class="flex items-center gap-5">
          <a
            href="/posts/"
            id="magnetic-btn"
            class="magnetic-btn group/btn inline-flex items-center gap-2 border border-foreground bg-foreground px-4 py-2 text-background transition-all duration-300 hover:border-accent hover:bg-accent hover:shadow-[0_0_24px_-4px_var(--color-accent)]"
          >
            <span class="sparkle-wrap relative"> 浏览文章 </span>
            <IconArrowRight
              class="size-4 transition-transform group-hover/btn:translate-x-1 rtl:-rotate-180"
            />
          </a>
          <a
            href="/about/"
            class="py-2 underline decoration-dashed underline-offset-4 transition-colors hover:text-accent"
          >
            关于我
          </a>
        </div>

        <div
          class="flex items-center gap-1 border-t border-border pt-3 sm:border-0 sm:pt-0"
        >
          <a
            target="_blank"
            href="/rss.xml"
            class="inline-flex items-center justify-center p-2 text-foreground/70 transition-all duration-200 hover:scale-110 hover:text-accent"
            aria-label="rss feed"
            title="RSS Feed"
          >
            <IconRss width={20} height={20} class="stroke-2" />
            <span class="sr-only">RSS Feed</span>
          </a>
          <Socials centered />
        </div>
      </div>
    </section>

    <!-- Wave divider -->
    <div class="wave-divider -mt-2 mb-2 overflow-hidden select-none">
      <svg viewBox="0 0 1200 40" preserveAspectRatio="none" class="h-6 w-full">
        <path
          d="M0,20 C150,40 350,0 600,20 C850,40 1050,0 1200,20 L1200,40 L0,40 Z"
          fill="var(--color-accent)"
          opacity="0.06"
          class="wave-path"></path>
        <path
          d="M0,25 C200,10 400,35 600,25 C800,15 1000,35 1200,25 L1200,40 L0,40 Z"
          fill="var(--color-accent)"
          opacity="0.04"
          class="wave-path-2"></path>
      </svg>
    </div>

    <!-- ========== Recent Posts ========== -->
    {
      recentPosts.length > 0 && (
        <section id="recent-posts" class="pt-2 pb-6">
          <div class="flex items-end justify-between border-b-2 border-foreground pb-2">
            <h2 class="text-xl font-bold tracking-wide">
              最近文章
              <span class="ms-2 align-middle text-xs font-normal tracking-[0.25em] text-foreground/45">
                RECENT
              </span>
            </h2>
            <a
              href="/posts/"
              class="group/link inline-flex items-center gap-1 text-sm text-foreground/70 transition-colors hover:text-accent"
            >
              查看全部
              <IconArrowRight class="size-3.5 transition-transform group-hover/link:translate-x-0.5 rtl:-rotate-180 rtl:group-hover/link:-translate-x-0.5" />
            </a>
          </div>

          {/* ===== Featured latest post with animated border ===== */}
          {latestPost && (
            <a
              href={getPath(latestPost.id, latestPost.filePath)}
              class="reveal group relative mt-5 block overflow-hidden border-l-2 border-accent/30 pl-4 transition-all duration-300 hover:border-accent hover:pl-5"
            >
              <div class="gradient-border-shine absolute inset-y-0 left-0 w-full opacity-0 transition-opacity duration-500 group-hover:opacity-100" />
              <div class="relative flex items-center gap-2 text-xs text-foreground/45">
                <span class="font-semibold text-accent">最新</span>
                <time
                  datetime={dayjs(
                    latestPost.data.modDatetime ?? latestPost.data.pubDatetime
                  ).toISOString()}
                >
                  {formatDate(
                    latestPost.data.modDatetime ?? latestPost.data.pubDatetime
                  )}
                </time>
                <span aria-hidden="true">·</span>
                <span>{estimateReadTime(latestPost.body)} min read</span>
              </div>
              <h3
                style={{
                  viewTransitionName: slugifyStr(latestPost.data.title),
                }}
                class="relative mt-1.5 text-xl leading-snug font-bold transition-colors group-hover:text-accent"
              >
                {latestPost.data.title}
              </h3>
              {latestPost.data.description && (
                <p class="relative mt-1 line-clamp-2 text-sm leading-6 text-foreground/70">
                  {latestPost.data.description}
                </p>
              )}
              {latestPost.data.tags.length > 0 && (
                <span class="relative mt-2 flex flex-wrap gap-x-3 text-xs text-foreground/50">
                  {latestPost.data.tags.slice(0, 3).map(tag => (
                    <span># {tag}</span>
                  ))}
                </span>
              )}
            </a>
          )}

          {/* ===== Post list with 3D tilt ===== */}
          <ul class="mt-2">
            {otherPosts.slice(0, SITE.postPerIndex - 1).map((post, index) => {
              const { id, filePath, data, body } = post;
              const { title, description, pubDatetime, modDatetime, tags } =
                data;
              return (
                <li class="reveal" style={`transition-delay: ${index * 80}ms`}>
                  <a
                    href={getPath(id, filePath)}
                    class="tilt-card group relative flex flex-col gap-1 border-b border-border py-4 transition-all duration-300 hover:bg-muted/30 sm:flex-row sm:gap-6 sm:px-2"
                  >
                    <span
                      class="absolute inset-y-0 left-[-1rem] w-[3px] origin-center scale-y-0 bg-accent transition-transform duration-200 group-hover:scale-y-100"
                      aria-hidden="true"
                    />
                    <time
                      datetime={dayjs(modDatetime ?? pubDatetime).toISOString()}
                      class="shrink-0 text-sm text-foreground/55 tabular-nums sm:w-28 sm:pt-0.5"
                    >
                      {formatDate(modDatetime ?? pubDatetime)}
                    </time>
                    <span class="flex-1">
                      <h3
                        style={{ viewTransitionName: slugifyStr(title) }}
                        class="text-base leading-snug font-medium transition-colors group-hover:text-accent"
                      >
                        {title}
                      </h3>
                      {description && (
                        <p class="mt-1 line-clamp-2 text-sm leading-6 text-foreground/70">
                          {description}
                        </p>
                      )}
                      <span class="mt-1.5 flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-foreground/45">
                        {tags.slice(0, 3).map(tag => (
                          <span># {tag}</span>
                        ))}
                        <span class="text-foreground/30">
                          {estimateReadTime(body)} min
                        </span>
                      </span>
                    </span>
                    <IconArrowRight
                      class="hidden size-4 -translate-x-1 self-center text-accent opacity-0 transition-all duration-200 group-hover:translate-x-0 group-hover:opacity-100 sm:block rtl:-rotate-180"
                      aria-hidden="true"
                    />
                  </a>
                </li>
              );
            })}
          </ul>
        </section>
      )
    }

    <!-- ========== Top Tags ========== -->
    {
      topTags.length > 0 && (
        <section id="topics" class="pt-8 pb-6">
          <div class="flex items-end justify-between border-b-2 border-foreground pb-2">
            <h2 class="text-xl font-bold tracking-wide">
              文章标签
              <span class="ms-2 align-middle text-xs font-normal tracking-[0.25em] text-foreground/45">
                TAGS
              </span>
            </h2>
            <a
              href="/tags/"
              class="group/link inline-flex items-center gap-1 text-sm text-foreground/70 transition-colors hover:text-accent"
            >
              全部标签
              <IconArrowRight class="size-3.5 transition-transform group-hover/link:translate-x-0.5 rtl:-rotate-180 rtl:group-hover/link:-translate-x-0.5" />
            </a>
          </div>

          <ul class="mt-5 flex flex-wrap justify-center gap-2 sm:justify-start">
            {topTags.map((tag, i) => (
              <li>
                <a
                  href={`/tags/${tag.slug}/`}
                  class:list={[
                    "reveal inline-flex items-baseline gap-1 border border-border px-2.5 py-1 transition-all duration-300 hover:-translate-y-1 hover:border-accent hover:text-accent hover:shadow-[0_6px_20px_-6px_var(--color-accent)]",
                    tagSizeClass(tag.count),
                  ]}
                  style={`transition-delay: ${i * 50}ms`}
                >
                  <span>#{tag.name}</span>
                  <span class="text-xs text-foreground/40 tabular-nums">
                    {tag.count}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <div class="mt-10 text-center">
      <a
        href="/posts/"
        id="bottom-cta"
        class="group/btn inline-flex items-center justify-center gap-2 border border-foreground px-5 py-2.5 transition-all duration-300 hover:border-accent hover:bg-accent hover:text-background hover:shadow-[0_0_28px_-4px_var(--color-accent)] sm:inline-flex"
      >
        查看全部文章（{totalPosts}）
        <IconArrowRight
          class="size-4 transition-transform group-hover/btn:translate-x-1 rtl:-rotate-180"
        />
      </a>
    </div>
  </main>
  <Footer />
</Layout>

<style>
  /* ===== Loading overlay ===== */
  #loader {
    transition: opacity 0.5s ease;
  }
  #loader.fade-out {
    opacity: 0;
    pointer-events: none;
  }
  .loader-dots::after {
    content: "...";
    animation: dots 1.4s steps(4) infinite;
  }
  @keyframes dots {
    0% {
      content: "";
    }
    25% {
      content: ".";
    }
    50% {
      content: "..";
    }
    75% {
      content: "...";
    }
  }

  /* ===== Shimmer on progress bar ===== */
  .shimmer {
    background: linear-gradient(
      90deg,
      transparent 0%,
      rgba(255, 255, 255, 0.4) 50%,
      transparent 100%
    );
    animation: shimmer 2s linear infinite;
  }
  @keyframes shimmer {
    0% {
      transform: translateX(-100%);
    }
    100% {
      transform: translateX(100%);
    }
  }

  /* ===== Cursor blink ===== */
  @keyframes cursor-blink {
    0%,
    45% {
      opacity: 1;
    }
    50%,
    100% {
      opacity: 0;
    }
  }
  .cursor-blink {
    animation: cursor-blink 1.1s step-end infinite;
  }

  /* ===== Animated gradient text ===== */
  .gradient-text {
    background: linear-gradient(
      90deg,
      var(--color-accent) 0%,
      var(--color-foreground) 50%,
      var(--color-accent) 100%
    );
    background-size: 200% auto;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: gradient-pan 3s linear infinite;
    filter: drop-shadow(
      0 0 12px color-mix(in srgb, var(--color-accent) 35%, transparent)
    );
  }
  @keyframes gradient-pan {
    0% {
      background-position: 0% center;
    }
    100% {
      background-position: 200% center;
    }
  }

  /* ===== Floating tech chips ===== */
  .float-anim {
    animation: float 3s ease-in-out infinite;
    animation-delay: var(--float-delay, 0s);
  }
  @keyframes float {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-3px);
    }
  }

  /* ===== Gradient border shine on featured post ===== */
  .gradient-border-shine {
    background: linear-gradient(
      90deg,
      transparent 0%,
      var(--color-accent) 50%,
      transparent 100%
    );
    opacity: 0;
  }

  /* ===== Wave divider ===== */
  .wave-path {
    animation: wave-move 8s ease-in-out infinite;
  }
  .wave-path-2 {
    animation: wave-move 6s ease-in-out infinite reverse;
  }
  @keyframes wave-move {
    0%,
    100% {
      transform: translateX(0);
    }
    50% {
      transform: translateX(-30px);
    }
  }

  /* ===== Entrance animations ===== */
  @keyframes rise-in {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  .hero-enter {
    animation: rise-in 0.5s ease-out both;
  }

  @keyframes chip-slide {
    from {
      opacity: 0;
      transform: translateY(8px) scale(0.9);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }
  .chip-enter {
    animation: chip-slide 0.4s ease-out both;
  }

  /* ===== Scroll reveal ===== */
  .reveal {
    opacity: 0;
    transform: translateY(16px);
    transition:
      opacity 0.5s ease-out,
      transform 0.5s ease-out;
  }
  .reveal.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* ===== 3D tilt card ===== */
  .tilt-card {
    transform-style: preserve-3d;
    perspective: 600px;
  }

  /* ===== Custom scrollbar ===== */
  ::-webkit-scrollbar {
    width: 8px;
    height: 8px;
  }
  ::-webkit-scrollbar-track {
    background: transparent;
  }
  ::-webkit-scrollbar-thumb {
    background: color-mix(in srgb, var(--color-accent) 40%, transparent);
    border-radius: 4px;
  }
  ::-webkit-scrollbar-thumb:hover {
    background: var(--color-accent);
  }

  /* ===== Sparkle ===== */
  .sparkle {
    position: absolute;
    pointer-events: none;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--color-accent);
    animation: sparkle-fly 0.6s ease-out forwards;
  }
  @keyframes sparkle-fly {
    0% {
      transform: translate(0, 0) scale(1);
      opacity: 1;
    }
    100% {
      transform: translate(var(--sx), var(--sy)) scale(0);
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      animation: none !important;
      transition: none !important;
    }
    .reveal {
      opacity: 1 !important;
      transform: none !important;
    }
    #loader {
      display: none !important;
    }
  }
</style>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset?.layout;
    if (indexLayout) sessionStorage.setItem("backUrl", "/");

    const prefersReducedMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)"
    ).matches;

    /* ===== Loading overlay ===== */
    const loader = document.getElementById("loader");
    if (loader) {
      setTimeout(() => {
        loader.classList.add("fade-out");
        setTimeout(() => loader.remove(), 500);
      }, 300);
    }

    /* ===== Scroll progress bar ===== */
    const progressBar = document.getElementById("scroll-progress");
    const updateProgress = () => {
      const sh = document.documentElement.scrollHeight - window.innerHeight;
      const p = sh > 0 ? window.scrollY / sh : 0;
      if (progressBar) progressBar.style.transform = `scaleX(${p})`;
    };
    window.addEventListener("scroll", updateProgress, { passive: true });
    updateProgress();

    /* ===== Intersection Observer ===== */
    const revealEls = document.querySelectorAll(".reveal");
    const observer = new IntersectionObserver(
      entries => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.1, rootMargin: "0px 0px -40px 0px" }
    );
    revealEls.forEach(el => observer.observe(el));

    /* ===== Counter animation ===== */
    const counters = document.querySelectorAll<HTMLElement>(".counter");
    counters.forEach(el => {
      const target = parseInt(el.dataset.count || "0", 10);
      let current = 0;
      const step = Math.max(1, Math.ceil(target / 30));
      const timer = setInterval(() => {
        current += step;
        if (current >= target) {
          current = target;
          clearInterval(timer);
        }
        el.textContent = String(current);
      }, 30);
    });

    /* ===== Terminal line typewriter ===== */
    const terminalEl = document.getElementById("terminal-line");
    const terminalText = "~/大波浪 $ whoami";
    if (terminalEl && !prefersReducedMotion) {
      terminalEl.textContent = "";
      let ti = 0;
      const tTimer = setInterval(() => {
        terminalEl.textContent += terminalText[ti];
        ti++;
        if (ti >= terminalText.length) clearInterval(tTimer);
      }, 60);
    } else if (terminalEl) {
      terminalEl.textContent = terminalText;
    }

    /* ===== Intro typewriter ===== */
    const introEl = document.getElementById("typewriter");
    const introText =
      "一名在补 Java 基础的后端开发。这里记录我日常踩过的坑——RocketMQ、Docker、Git、虚拟机与小程序，也偶尔写点读书笔记和胡思乱想。";
    if (introEl && !prefersReducedMotion) {
      introEl.textContent = "";
      let ii = 0;
      setTimeout(() => {
        const iTimer = setInterval(() => {
          introEl.textContent += introText[ii];
          ii++;
          if (ii >= introText.length) clearInterval(iTimer);
        }, 25);
      }, 1200);
    } else if (introEl) {
      introEl.textContent = introText;
    }

    /* ===== Mouse spotlight on hero ===== */
    const hero = document.getElementById("hero");
    const spotlight = document.getElementById("spotlight");
    if (hero && spotlight) {
      hero.addEventListener("mousemove", (e: MouseEvent) => {
        const rect = hero.getBoundingClientRect();
        const x = e.clientX - rect.left;
        const y = e.clientY - rect.top;
        spotlight.style.background = `radial-gradient(circle 200px at ${x}px ${y}px, color-mix(in srgb, var(--color-accent) 12%, transparent), transparent)`;
        spotlight.style.opacity = "1";
      });
      hero.addEventListener("mouseleave", () => {
        spotlight.style.opacity = "0";
      });
    }

    /* ===== Magnetic button ===== */
    const magneticBtn = document.getElementById("magnetic-btn");
    if (magneticBtn) {
      magneticBtn.addEventListener("mousemove", (e: MouseEvent) => {
        const rect = magneticBtn.getBoundingClientRect();
        const x = e.clientX - rect.left - rect.width / 2;
        const y = e.clientY - rect.top - rect.height / 2;
        magneticBtn.style.transform = `translate(${x * 0.2}px, ${y * 0.25}px)`;
      });
      magneticBtn.addEventListener("mouseleave", () => {
        magneticBtn.style.transform = "";
      });
    }

    /* ===== 3D tilt on post cards ===== */
    if (!prefersReducedMotion) {
      document.querySelectorAll<HTMLElement>(".tilt-card").forEach(card => {
        card.addEventListener("mousemove", (e: MouseEvent) => {
          const rect = card.getBoundingClientRect();
          const cx = e.clientX - rect.left;
          const cy = e.clientY - rect.top;
          const rx = (cy / rect.height - 0.5) * -6;
          const ry = (cx / rect.width - 0.5) * 6;
          card.style.transform = `perspective(600px) rotateX(${rx}deg) rotateY(${ry}deg)`;
        });
        card.addEventListener("mouseleave", () => {
          card.style.transform = "";
        });
      });
    }

    /* ===== Sparkle on button click ===== */
    function createSparkles(el: HTMLElement, count = 8) {
      const rect = el.getBoundingClientRect();
      for (let i = 0; i < count; i++) {
        const s = document.createElement("span");
        s.className = "sparkle";
        const angle = (Math.PI * 2 * i) / count;
        const dist = 20 + Math.random() * 20;
        s.style.left = rect.width / 2 + "px";
        s.style.top = rect.height / 2 + "px";
        s.style.setProperty("--sx", Math.cos(angle) * dist + "px");
        s.style.setProperty("--sy", Math.sin(angle) * dist + "px");
        el.appendChild(s);
        setTimeout(() => s.remove(), 600);
      }
    }
    document
      .querySelectorAll<HTMLElement>("#magnetic-btn, #bottom-cta")
      .forEach(btn => {
        btn.addEventListener("click", () => createSparkles(btn, 10));
      });

    /* ===== Particle canvas ===== */
    const canvas = document.getElementById("particles") as HTMLCanvasElement;
    const heroSection = document.getElementById("hero");
    if (canvas && heroSection && !prefersReducedMotion) {
      const ctx = canvas.getContext("2d");
      if (ctx) {
        let particles: { x: number; y: number; vx: number; vy: number }[] = [];
        const resize = () => {
          const r = heroSection.getBoundingClientRect();
          canvas.width = r.width;
          canvas.height = r.height;
          canvas.style.width = r.width + "px";
          canvas.style.height = r.height + "px";
          const count = Math.min(40, Math.floor(r.width / 25));
          particles = Array.from({ length: count }, () => ({
            x: Math.random() * canvas.width,
            y: Math.random() * canvas.height,
            vx: (Math.random() - 0.5) * 0.3,
            vy: (Math.random() - 0.5) * 0.3,
          }));
        };
        resize();
        window.addEventListener("resize", resize);

        const accent = getComputedStyle(document.documentElement)
          .getPropertyValue("--accent")
          .trim();

        let animId: number;
        const animate = () => {
          ctx.clearRect(0, 0, canvas.width, canvas.height);

          particles.forEach(p => {
            p.x += p.vx;
            p.y += p.vy;
            if (p.x < 0 || p.x > canvas.width) p.vx *= -1;
            if (p.y < 0 || p.y > canvas.height) p.vy *= -1;
          });

          // Draw connections
          for (let i = 0; i < particles.length; i++) {
            for (let j = i + 1; j < particles.length; j++) {
              const dx = particles[i].x - particles[j].x;
              const dy = particles[i].y - particles[j].y;
              const dist = Math.sqrt(dx * dx + dy * dy);
              if (dist < 100) {
                const opacity = (1 - dist / 100) * 0.15;
                ctx.strokeStyle = accent;
                ctx.globalAlpha = opacity;
                ctx.lineWidth = 0.5;
                ctx.beginPath();
                ctx.moveTo(particles[i].x, particles[i].y);
                ctx.lineTo(particles[j].x, particles[j].y);
                ctx.stroke();
              }
            }
            // Draw particle
            ctx.globalAlpha = 0.3;
            ctx.fillStyle = accent;
            ctx.beginPath();
            ctx.arc(particles[i].x, particles[i].y, 1, 0, Math.PI * 2);
            ctx.fill();
          }
          ctx.globalAlpha = 1;
          animId = requestAnimationFrame(animate);
        };

        let running = false;
        const startAnim = () => {
          if (running) return;
          running = true;
          animate();
        };
        const stopAnim = () => {
          running = false;
          cancelAnimationFrame(animId);
        };

        // Pause when out of view
        const heroObs = new IntersectionObserver(entries => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              startAnim();
            } else {
              stopAnim();
            }
          });
        });
        heroObs.observe(canvas);
      }
    }
  });
</script>
