---
import type { Page } from "astro";
import type { CollectionEntry } from "astro:content";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";

export interface Props {
  page: Page<CollectionEntry<"blog">>;
}

const { page } = Astro.props;
---

{
  page.lastPage > 1 && (
    <nav
      class="mt-8 mb-8 flex items-center justify-center gap-4"
      aria-label="Pagination"
    >
      <a
        href={page.url.prev ? (page.url.prev as string) : undefined}
        class:list={[
          "group inline-flex items-center gap-1.5 border border-border px-4 py-2 text-sm transition-all duration-300",
          "hover:border-accent hover:text-accent hover:shadow-[0_0_16px_-4px_var(--color-accent)]",
          { "pointer-events-none opacity-40": !page.url.prev },
        ]}
        aria-label="Previous page"
      >
        <IconArrowRight class="size-4 rotate-180 transition-transform group-hover:-translate-x-0.5 rtl:rotate-0 rtl:group-hover:translate-x-0.5" />
        上一页
      </a>

      {/* Page indicator */}
      <span class="font-mono text-sm text-foreground/60 tabular-nums">
        <span class="font-bold text-accent">{page.currentPage}</span>
        <span class="mx-1 text-foreground/30">/</span>
        <span>{page.lastPage}</span>
      </span>

      <a
        href={page.url.next ? (page.url.next as string) : undefined}
        class:list={[
          "group inline-flex items-center gap-1.5 border border-border px-4 py-2 text-sm transition-all duration-300",
          "hover:border-accent hover:text-accent hover:shadow-[0_0_16px_-4px_var(--color-accent)]",
          { "pointer-events-none opacity-40": !page.url.next },
        ]}
        aria-label="Next page"
      >
        下一页
        <IconArrowRight class="size-4 transition-transform group-hover:translate-x-0.5 rtl:-rotate-180 rtl:group-hover:-translate-x-0.5" />
      </a>
    </nav>
  )
}
