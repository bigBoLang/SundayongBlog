---
const isDark = Astro.props.isDark ?? false;
---

<div class="giscus-wrapper mt-8">
  <script
    is:inline
    src="https://giscus.app/client.js"
    data-repo="bigBoLang/SundayongBlog"
    data-repo-id="R_kgDOQygc5w"
    data-category="Announcements"
    data-category-id="DIC_kwDOQygc584DKOGe"
    data-mapping="pathname"
    data-strict="0"
    data-reactions-enabled="1"
    data-emit-metadata="0"
    data-input-position="bottom"
    data-theme={isDark ? "dark_dimmed" : "light"}
    data-lang="zh-CN"
    crossorigin="anonymous"
    async
  ></script>
</div>

<style>
  .giscus-wrapper {
    @apply mt-8 rounded-lg border border-border bg-muted/20 p-4;
  }
</style>
